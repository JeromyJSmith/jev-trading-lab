   "catalog_id": "L3.A",
   "name": "Catalyst quality grade",
   "blurb": "Novelty, magnitude, credibility: three Scores, weights 0.3/0.5/0.2 in code, bands A/B/C. Retune a weight, not a prompt.",
   "spec": "decisions/projects/jev-levels-trading/L3/A_catalyst_quality.yaml",
   "version": "0.1.0",
   "approval_status": "experimental",
   "questions": {
    "novelty": {
     "type": "score",
     "instructions": "How new is the information in `headline` for `symbol` (vs already known/expected)?",
     "criteria": [
      "already known",
      "partly new",
      "mostly new",
      "complete surprise"
     ]
    },
    "magnitude": {
     "type": "score",
     "instructions": "How large is the likely effect on `symbol`'s revenue or valuation?",
     "criteria": [
      "negligible",
      "small",
      "material",
      "transformational"
     ]
    },
    "credibility": {
     "type": "score",
     "instructions": "How credible is the source and wording?",
     "criteria": [
      "rumour or promo",
      "unnamed sources",
      "named outlet",
      "company filing or press release"
     ]
    }
   },
   "review_floor": 0.4,
   "thresholds": {
    "review_floor": 0.4,
    "w_novelty": 0.3,
    "w_magnitude": 0.5,
    "w_credibility": 0.2,
    "grade_a": 0.75,
    "grade_b": 0.5
   },
   "outputs": [
    {
     "outcome": "grade_a",
     "meaning": "A catalyst: would size normally"
    },
    {
     "outcome": "grade_b",
     "meaning": "B catalyst: would size half"
    },
    {
     "outcome": "grade_c",
     "meaning": "C: would not trade the catalyst"
    },
    {
     "outcome": "rejected_input",
     "meaning": "rejected in code before any Jev call (non NYSE/Nasdaq venue, future data, or bad input)"
    }
