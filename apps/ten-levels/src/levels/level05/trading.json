   "key": "A",
   "id": "l5_a_news_depth_router",
   "catalog_id": "L5.A",
   "name": "News depth router",
   "blurb": "Send each headline to the cheap rule, the deep model review, or an analyst. Most headlines never touch the big model.",
   "spec": "decisions/projects/jev-levels-trading/L5/A_news_depth_router.yaml",
   "version": "0.1.0",
   "approval_status": "experimental",
   "questions": {
    "depth": {
     "type": "choice",
     "instructions": "How much work does `headline` need before it can affect a trade in `symbol`?",
     "criteria": {
      "rule": "Routine and mechanical: dividend, conference, scheduled date",
      "deep": "Material but readable: earnings, contracts, guidance",
      "analyst": "Complex, legal or ambiguous: M&A terms, litigation, restatement"
     }
    }
   },
   "review_floor": 0.5,
   "thresholds": {
    "review_floor": 0.5
   },
   "outputs": [
    {
     "outcome": "cheap_rule",
     "meaning": "would apply the cheap rule (no model)"
    },
    {
     "outcome": "deep_review",
     "meaning": "would send to the deep model review"
    },
    {
     "outcome": "analyst",
     "meaning": "would route to an analyst"
    },
    {
     "outcome": "rejected_input",
     "meaning": "rejected in code before any Jev call (non NYSE/Nasdaq venue, future data, or bad input)"
    }
   ],
