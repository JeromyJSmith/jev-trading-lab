  {
   "key": "G",
   "id": "l2_g_order_note_parse",
   "catalog_id": "L2.G",
   "name": "Parse a trader's order note",
   "blurb": "Three Choices on a free-text note: side, order type, time in force. Code drafts a paper ticket only when every field is a declared label.",
   "spec": "decisions/projects/jev-levels-trading/L2/G_order_note_parse.yaml",
   "version": "0.1.0",
   "approval_status": "experimental",
   "questions": {
    "side": {
     "type": "choice",
     "instructions": "In `note`, does the trader want to buy, sell, or short?",
     "criteria": {
      "buy": "Buy / go long",
      "sell": "Sell to close a long",
      "short": "Sell short",
      "unclear": "Not stated"
     }
    },
    "order_type": {
     "type": "choice",
     "instructions": "What order type does `note` ask for?",
     "criteria": {
      "market": "Market",
      "limit": "Limit",
      "stop": "Stop or stop-limit",
      "unclear": "Not stated"
     }
    },
    "tif": {
     "type": "choice",
     "instructions": "What time in force?",
     "criteria": {
      "day": "Day or not stated",
      "gtc": "Good till cancelled",
      "ext": "Extended hours"
     }
    }
   },
   "review_floor": 0.4,
   "thresholds": {
    "review_floor": 0.4
   },
   "outputs": [
    {
     "outcome": "draft_paper_ticket",
     "meaning": "would draft a PAPER ticket for human confirmation (never sent)"
    },
    {
     "outcome": "needs_clarification",
     "meaning": "would ask the trader"
    },
    {
     "outcome": "rejected_input",
     "meaning": "rejected in code before any Jev call (non NYSE/Nasdaq venue, future data, or bad input)"
    }
   ],
   "cost_class": "standard",
   "jev_calls": "1 call",
   "runs_in": "schema_call",
   "stage_hint": "signal_filter",
   "input_schema": {
    "type": "object",
