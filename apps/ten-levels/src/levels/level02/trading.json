   "id": "l2_e_setup_family",
   "catalog_id": "L2.E",
   "name": "Which setup is this chart?",
   "blurb": "One Choice over setup families with a 'none' exit, plus a Noul 'is volume confirming'. Code sends each family to its own playbook.",
   "spec": "decisions/projects/jev-levels-trading/L2/E_setup_family.yaml",
   "version": "0.1.0",
   "approval_status": "experimental",
   "questions": {
    "family": {
     "type": "choice",
     "instructions": "Which setup family does `chart_description` on `timeframe` show for `symbol`?",
     "criteria": {
      "breakout": "Price clears a well-defined resistance or range high",
      "pullback": "Retrace to support/moving average in an uptrend",
      "range": "Sideways between support and resistance",
      "reversal": "Trend change pattern (double top/bottom, failed breakdown)",
      "none": "No clear setup"
     }
    },
    "volume_confirms": {
     "type": "noul",
     "instructions": "Does the description say volume confirms the move?",
     "criteria": {
      "true": "Volume expands with the move",
      "false": "Volume is flat, falling, or not mentioned"
     }
    }
   },
   "review_floor": 0.4,
   "thresholds": {
    "review_floor": 0.4
   },
   "outputs": [
    {
     "outcome": "breakout",
     "meaning": "would load the breakout playbook"
    },
    {
     "outcome": "pullback",
     "meaning": "would load the pullback playbook"
    },
    {
     "outcome": "range",
     "meaning": "would load the range playbook"
    },
    {
     "outcome": "reversal",
     "meaning": "would load the reversal playbook"
    },
    {
     "outcome": "watch",
     "meaning": "would watch, not act"
    },
    {
     "outcome": "rejected_input",
     "meaning": "rejected in code before any Jev call (non NYSE/Nasdaq venue, future data, or bad input)"
    }
   ],
   "cost_class": "cheap",
   "jev_calls": "1 call",
   "runs_in": "schema_call",
   "stage_hint": "signal_filter",
   "input_schema": {
    "type": "object",
    "required": [
     "symbol",
     "venue",
     "data_cutoff",
     "timeframe",
     "chart_description"
    ],
    "properties": {
     "symbol": {
      "type": "string"
     },
     "venue": {
      "type": "string",
      "description": "NYSE or NASDAQ; anything else is rejected in code"
     },
     "data_cutoff": {
      "type": "string"
     },
