   "key": "A",
   "id": "l2_a_headline_triage",
   "catalog_id": "L2.A",
   "name": "Headline triage",
   "blurb": "Two Choices in one call: what kind of event, which direction for shareholders. Code maps the pair to alert, watch or ignore.",
   "spec": "decisions/projects/jev-levels-trading/L2/A_headline_triage.yaml",
   "version": "0.1.0",
   "approval_status": "experimental",
   "questions": {
    "event": {
     "type": "choice",
     "instructions": "What kind of event does `headline` report for `symbol`?",
     "criteria": {
      "earnings": "Results or guidance",
      "m_and_a": "Merger, acquisition, takeover offer",
      "financing": "Offering, debt, convertible",
      "legal_regulatory": "Lawsuit, probe, approval, fine",
      "management": "Executive change",
      "product": "Product, contract, customer",
      "routine": "Dividend, conference, routine filing",
      "other": "None of these"
     }
    },
    "direction": {
     "type": "choice",
     "instructions": "For `symbol` shareholders, is this news positive, negative or neutral?",
     "criteria": {
      "positive": "Likely raises the value",
      "negative": "Likely lowers the value",
      "neutral": "No clear effect"
     }
    }
   },
   "review_floor": 0.4,
   "thresholds": {
    "review_floor": 0.4
   },
   "outputs": [
    {
     "outcome": "alert",
     "meaning": "would alert the desk now"
    },
    {
     "outcome": "watch",
     "meaning": "would add to the watch list"
    },
    {
     "outcome": "ignore",
     "meaning": "no action"
    },
    {
     "outcome": "rejected_input",
     "meaning": "rejected in code before any Jev call (non NYSE/Nasdaq venue, future data, or bad input)"
    }
