     "type": "noul",
     "instructions": "Is `headline` mainly about the company traded as `symbol`?",
     "criteria": {
      "true": "The company behind `symbol` is the subject or directly affected",
      "false": "It is about another company, the market, or only mentions the name in passing"
     }
    }
   },
   "review_floor": 0.5,
   "thresholds": {
    "threshold": 0.7
   },
   "outputs": [
    {
     "outcome": "attach",
     "meaning": "would attach the headline to the symbol's news feed"
    },
