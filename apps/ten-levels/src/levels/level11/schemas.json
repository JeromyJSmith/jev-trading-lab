     "instructions": "Which setup family do `observations` for `symbol` on `timeframe` describe?",
     "criteria": {
      "breakout": "Price pushes through a marked resistance or range high with expanding volume",
      "pullback_continuation": "Trend intact, price retraces to support or a moving average and resumes",
      "mean_reversion": "Stretched far from a mean or band, observations point back toward it",
      "range_bound": "Oscillating between support and resistance with no directional break",
      "gap_and_go": "Opening gap that holds and extends in the gap direction",
      "reversal": "Trend exhaustion followed by a structure break in the opposite direction",
      "unclear": "Observations are unreadable, contradictory, or too sparse to name a family",
      "other": "A recognisable setup that is none of the above"
     }
    }
   },
   "review_floor": 0.5,
