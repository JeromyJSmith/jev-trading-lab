  {
   "key": "B",
   "id": "strategy_signal_gate",
   "name": "Strategy signal gate",
   "blurb": "Marimo lab gate: do aligned observations + numeric features fit a strategy hypothesis? Paper-only output.",
   "spec": "decisions/projects/trading-workbench/strategy_signal_gate.yaml",
   "version": "1.1.1",
   "approval_status": "experimental",
   "questions": {
    "matches": {
     "type": "choice",
     "instructions": "Do `observations` and `features` fit `hypothesis` for `symbol` on `timeframe`?",
     "criteria": {
      "matches": "The described conditions are all present",
      "partial": "Some conditions present, some missing",
      "contradicts": "The observations argue against the hypothesis",
      "unclear": "Not enough information to tell"
     }
    },
    "observation_quality": {
     "type": "score",
     "instructions": "How complete and consistent are `observations`?",
     "criteria": [
      "Sparse or contradictory",
      "Usable with gaps",
      "Complete and internally consistent"
     ]
    },
    "conflicting_evidence": {
     "type": "noul",
     "instructions": "Does anything in `observations` or `features` state the OPPOSITE of a condition in `hypothesis`?",
     "criteria": {
      "true": "An observation reverses a condition: price below the level the hypothesis needs above, trend down when it needs up, a failed or reversed breakout",
      "false": "Conditions are met, or a condition is merely absent, weaker than required, not reached yet, or neutral (for example volume below the bar, price just under the level, a flat trend)"
     }
    }
   },
   "review_floor": 0.5,
   "input_schema": {
    "type": "object",
    "required": [
     "symbol",
     "timeframe",
     "data_cutoff",
     "observation",
     "hypothesis",
     "features"
    ],
    "properties": {
     "symbol": {
      "type": "string",
      "minLength": 1
     },
     "timeframe": {
      "type": "string",
      "minLength": 1
     },
     "data_cutoff": {
      "type": "string"
     },
     "as_of": {
      "type": "string"
     },
     "hypothesis": {
      "type": "string",
      "minLength": 1
     },
     "features": {
      "type": "object"
     },
     "observation": {
      "type": "object",
      "required": [
       "symbol",
       "timeframe",
       "data_cutoff"
      ]
     }
    }
   },
