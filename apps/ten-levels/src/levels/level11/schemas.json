  {
   "key": "C",
   "id": "backtest_result_review",
   "name": "Backtest result review",
   "blurb": "Marimo lab: qualitative review of a backtest after deterministic metric checks. Never promotes a strategy.",
   "spec": "decisions/projects/trading-workbench/backtest_result_review.yaml",
   "version": "1.1.1",
   "approval_status": "experimental",
   "questions": {
    "lookahead_risk": {
     "type": "noul",
     "instructions": "Does `config_summary` or `notes` suggest the backtest used information not available at decision time?",
     "criteria": {
      "true": "Same-bar close used for entry, future-adjusted data, survivorship-filtered universe, labels computed after the fact",
      "false": "Point-in-time data, signals computed on closed bars, historical universe snapshots"
     }
    },
    "overfit_risk": {
     "type": "score",
     "instructions": "How likely is the result in `metrics` an artefact of tuning described in `config_summary`?",
     "criteria": [
      "Few parameters fixed in advance, out-of-sample tested",
      "Some tuning, partial out-of-sample",
      "Many tuned parameters, no out-of-sample, or cherry-picked periods"
     ]
    },
    "cost_realism": {
     "type": "score",
     "instructions": "How realistic are the costs and fills in `config_summary`?",
     "criteria": [
      "No costs or slippage modelled",
      "Commissions only or fixed slippage",
      "Commissions, spread, slippage and fill rules"
     ]
    }
   },
   "review_floor": 0.5,
   "input_schema": {
    "type": "object",
    "required": [
     "metrics",
     "config_summary"
    ],
    "properties": {
     "metrics": {
      "type": "object",
      "required": [
       "trades"
      ],
      "properties": {
       "trades": {
        "type": "integer",
        "minimum": 0
