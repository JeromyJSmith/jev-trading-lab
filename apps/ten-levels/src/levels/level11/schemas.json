       "Many tuned parameters, no out-of-sample, or cherry-picked periods"
      ]
     },
     {
      "id": "cost_realism",
      "type": "score",
      "short": "cost realism",
      "text": "How realistic are the costs and fills in `config_summary`?",
      "options": [
       "No costs or slippage modelled",
       "Commissions only or fixed slippage",
       "Commissions, spread, slippage and fill rules"
      ]
     }
    ],
    "outcomes": [
     {
      "id": "reject",
      "meaning": "lookahead risk",
      "when": [
       "lookahead_risk ≥ 0.50"
      ],
      "more": 0,
      "stages": [
       "guard"
      ],
      "code_only": true
     },
     {
      "id": "needs_more_evidence",
      "meaning": "overfit or cost realism problem",
      "when": [
       "cost_realism conf ≥ 0.34 and cost_realism < 0.50",
       "overfit_risk conf ≥ 0.34 and overfit_risk ≥ 0.60",
       "overfit_risk ≥ 0.60 or cost_realism < 0.50"
      ],
      "more": 0,
      "stages": [
       "gate",
       "decide"
      ],
      "code_only": false
     },
     {
      "id": "eligible_for_frozen_evaluation",
      "meaning": "may enter a frozen evaluation; not a promotion",
      "when": [
       "otherwise: passes qualitative review (never promotes)"
      ],
      "more": 0,
      "stages": [
       "default"
      ],
      "code_only": false
     },
     {
      "id": "insufficient_sample",
      "meaning": "too few trades (no call)",
      "when": [
       "too few trades to review"
      ],
      "more": 0,
      "stages": [
       "guard"
      ],
      "code_only": true
     },
     {
      "id": "__abstain__",
      "meaning": "abstain: no outcome, a person reviews",
      "when": [
       "min([overfit_risk conf, cost_realism conf]) < 0.34"
      ],
      "more": 0,
      "stages": [
       "gate"
      ],
      "code_only": false
     }
    ],
    "arrows": {
     "input": "state built from metrics, config_summary, notes",
     "guards": "guards in code first: insufficient_sample",
     "output": "guard → gate → decide in code",
     "output_detail": "min trades 30 · lookahead 0.50 · overfit 0.60"
    }
   }
